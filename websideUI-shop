    u8g2.setFont(u8g2_font_6x10_tf);
    int16_t notifW = u8g2.getStrWidth(notificationMsg);
    u8g2.drawStr(128 - notifW - 4, 26, notificationMsg);
    
    float dispPercent = getDisplayPercent(aiLevel);
    
    drawTank(dispPercent);
    drawSmoothTimer();
    char pbuf[6];
    sprintf(pbuf, "%d%%", (int)(dispPercent + 0.5));
    u8g2.setFont(u8g2_font_logisoso18_tr);
    u8g2.drawStr(44, 56, pbuf);
    u8g2.sendBuffer();
}

// ==================== BOOT SCREEN ====================
void showBootScreen() {
    unsigned long startTime = millis();
    while (millis() - startTime < 1000) {
        int progress = map(millis() - startTime, 0, 1000, 0, 100);
        u8g2.clearBuffer();
        u8g2.setFont(u8g2_font_7x14B_tf);
        String dots = "";
        int phase = (millis() / 400) % 3;
        if (phase == 0) dots = ".";
        if (phase == 1) dots = "..";
        if (phase == 2) dots = "...";
        String loadingText = "Loading" + dots;
        u8g2.drawStr(30, 26, loadingText.c_str());
        u8g2.drawFrame(14, 40, 100, 4);
        int barWidth = map(progress, 0, 100, 0, 98);
        if (barWidth > 0) u8g2.drawBox(15, 41, barWidth, 2);
        u8g2.sendBuffer();
        delay(20);
    }
    unsigned long endTime = millis() + 1400;
    while (millis() < endTime) {
        u8g2.clearBuffer();
        u8g2.setFont(u8g2_font_7x14B_tf);
        u8g2.drawStr(16, 40, "By Sunny Pandit");
        u8g2.sendBuffer();
        delay(20);
    }
    u8g2.clearBuffer();
    u8g2.sendBuffer();
}

// ==================== SETUP ====================
void setup() {
    Serial.begin(115200);
    delay(100);
    EEPROM.begin(EEPROM_SIZE);
    incrementBootCount();
    sys.motor = false;
    sys.forceFlag = false;
    sys.stopFlag = false;
    sys.timerType = 0;
    sys.timerEndTime = 0;
    sys.motorStartTime = 0;
    sys.customTimerSeconds = 0;
    Wire.begin(OLED_SDA, OLED_SCL);
    u8g2.begin();
    u8g2.setBusClock(400000);
    u8g2.setPowerSave(0);
    pinMode(TRIG_PIN, OUTPUT);
    pinMode(ECHO_PIN, INPUT);
    pinMode(RELAY_PIN, OUTPUT);
    digitalWrite(RELAY_PIN, HIGH);
    pinMode(BUZZER_PIN, OUTPUT);
    digitalWrite(BUZZER_PIN, LOW);
    pinMode(BTN1, INPUT_PULLUP);
    pinMode(BTN2, INPUT_PULLUP);
    pinMode(BTN3, INPUT_PULLUP);
    pinMode(BTN4, INPUT_PULLUP);
    pinMode(BTN5, INPUT_PULLUP);
    pinMode(LDR_PIN, INPUT_PULLUP);
    pinMode(TANK_LOW_PIN, INPUT_PULLUP);
    pinMode(TANK_HIGH_PIN, INPUT_PULLUP);
    lastBtn1State = digitalRead(BTN1);
    lastBtn2State = digitalRead(BTN2);
    lastBtn3State = digitalRead(BTN3);
    lastBtn4State = digitalRead(BTN4);
    lastBtn5State = digitalRead(BTN5);
    attachInterrupt(digitalPinToInterrupt(ECHO_PIN), echoISR, CHANGE);
    showBootScreen();
    uiTask();
    u8g2.sendBuffer();
    client.setInsecure();
    client.setTimeout(3000);
    initWiFi();
    ArduinoOTA.setHostname("ESP32-TankController");
    ArduinoOTA.setPassword("RadheKrishna#108");
    ArduinoOTA.onStart([]() {
        String type;
        if (ArduinoOTA.getCommand() == U_FLASH) type = "sketch";
        else type = "filesystem";
        Serial.println("OTA Start: " + type);
    });
    ArduinoOTA.onEnd([]() { Serial.println("\nOTA End"); });
    ArduinoOTA.onProgress([](unsigned int progress, unsigned int total) {
        Serial.printf("Progress: %u%%\r", (progress / (total / 100)));
    });
    ArduinoOTA.onError([](ota_error_t error) {
        Serial.printf("Error[%u]: ", error);
        if (error == OTA_AUTH_ERROR) Serial.println("Auth Failed");
        else if (error == OTA_BEGIN_ERROR) Serial.println("Begin Failed");
        else if (error == OTA_CONNECT_ERROR) Serial.println("Connect Failed");
        else if (error == OTA_RECEIVE_ERROR) Serial.println("Receive Failed");
        else if (error == OTA_END_ERROR) Serial.println("End Failed");
    });
    ArduinoOTA.begin();
    
    telegramQueue = xQueueCreate(15, 160 * sizeof(char));
    
    xTaskCreatePinnedToCore(telegramTask, "TelegramTask", 17000, NULL, 1, NULL, 1);
    
    bootTime = millis();
}

// ==================== MAIN LOOP ====================
void loop() {
    unsigned long now = millis();
    
    if (now - lastWiFiCheckTime > 2000) {
        checkWiFi();
        lastWiFiCheckTime = now;
    }
    
    if (now - lastSensorTime > 200) {
        float levelPercent = getUltrasonicLevelPercent();
        aiLevel = kalmanUpdate(levelPercent);
        lastSensorTime = now;
    }
    
    buttonControlTask();
    checkAndHandleLightCut();
    checkAndHandleTankSensors();
    systemManager();
    
    digitalWrite(RELAY_PIN, sys.motor ? LOW : HIGH);
    
    if (now - lastTimeFetchTime > 2000) {
        updateTime();
        lastTimeFetchTime = now;
    }
    
    if (now - lastUITime > 150) {
        uiTask();
        lastUITime = now;
    }
    
    ArduinoOTA.handle();
    delay(1);
}
