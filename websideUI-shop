// ==================== ULTRASONIC INTERRUPT ====================
void IRAM_ATTR echoISR() {
    if (digitalRead(ECHO_PIN) == HIGH) {
        pulseStartTime = micros();
        measuring = true;
    } else {
        if (measuring) {
            pulseDuration = micros() - pulseStartTime;
            pulseComplete = true;
            measuring = false;
        }
    }
}

void startUltrasonicMeasurement() {
    digitalWrite(TRIG_PIN, LOW);
    delayMicroseconds(2);
    digitalWrite(TRIG_PIN, HIGH);
    delayMicroseconds(10);
    digitalWrite(TRIG_PIN, LOW);
    noInterrupts();
    pulseComplete = false;
    interrupts();
    measurementStartMicros = micros();
    measurementInProgress = true;
}

float getUltrasonicLevelPercent() {
    unsigned long now = millis();
    if (!measurementInProgress && (now - lastMeasurementTime) >= MEASUREMENT_INTERVAL_MS) {
        startUltrasonicMeasurement();
        lastMeasurementTime = now;
        return kalmanEstimate;
    }
    if (measurementInProgress && (micros() - measurementStartMicros) > MAX_VALID_DURATION) {
        measurementInProgress = false;
        return kalmanEstimate;
    }
    bool isComplete = false;
    unsigned long duration = 0;
    noInterrupts();
    isComplete = pulseComplete;
    if (isComplete) {
        duration = pulseDuration;
        pulseComplete = false;
    }
    interrupts();
    if (isComplete) {
        measurementInProgress = false;
        if (duration < MIN_VALID_DURATION || duration > MAX_VALID_DURATION) {
            return kalmanEstimate;
        }
        float dist = duration * 0.0343 / 2.0;
        float waterHeight = tankHeight - (dist - sensorOffset);
        waterHeight = constrain(waterHeight, 0, tankHeight);
        float percent = (waterHeight / tankHeight) * 100.0;
        rawBuffer[rawIndex++] = percent;
        if (rawIndex >= 5) rawIndex = 0;
        if (rawReadingsCount < 5) rawReadingsCount++;
        float sum = 0;
        for (int i = 0; i < rawReadingsCount; i++) sum += rawBuffer[i];
        return sum / rawReadingsCount;
    }
    return kalmanEstimate;
}

float kalmanUpdate(float measurement) {
    if (!kalmanInitialized) {
        kalmanEstimate = measurement;
        kalmanInitialized = true;
        return kalmanEstimate;
    }
    kalmanError += kalmanQ;
    float K = kalmanError / (kalmanError + kalmanR);
    kalmanEstimate += K * (measurement - kalmanEstimate);
    kalmanError *= (1 - K);
    return kalmanEstimate;
}

