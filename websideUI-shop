// ==================== SYSTEM MANAGER ====================
void systemManager() {
    unsigned long now = millis();
    
    if (showingStopMessage && (now - lastStopMessageTime) > 3000) {
        showingStopMessage = false;
        sys.stopFlag = false;
    }
    
    if (sys.stopFlag) {
        sys.motor = false;
        sys.forceFlag = false;
        sys.timerType = 0;
        sys.timerEndTime = 0;
        sys.customTimerSeconds = 0;
        if (!showingStopMessage) {
            showingStopMessage = true;
            lastStopMessageTime = now;
        }
        strcpy(notificationMsg, "STOP");
        specialEventActive = false;
        
        if (isNightMode()) {
            if (nightClockDelay == 0)
                nightClockDelay = millis();

            if (millis() - nightClockDelay >= 2000)
                nightClockMode = true;
        } else {
            nightClockMode = false;
            nightClockDelay = 0;
        }
        
        return;
    }
    
    if (!sys.stopFlag && showingStopMessage) showingStopMessage = false;
    
    if (sys.forceFlag) {
        sys.motor = true;
    }
    else if (sys.timerType == 99 || sys.timerType == AUTO_TANK_MODE) {
        autoModeManager();
    }
    else if (sys.timerType != 0) {
        if (now >= sys.timerEndTime) {
            sys.timerType = 0;
            sys.timerEndTime = 0;
            sys.customTimerSeconds = 0;
            sys.motor = false;
            
