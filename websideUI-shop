            wifiConnected = true;
            if (!ntpSynced) {
                configTime(19800, 0, "pool.ntp.org", "time.nist.gov");
                struct tm timeinfo;
                int retry = 0;
                while (!getLocalTime(&timeinfo, 1) && retry < 5) {
                    delay(100);
                    retry++;
                }
                if (retry < 5) {
                    ntpSynced = true;
                    hour = timeinfo.tm_hour;
                    minute = timeinfo.tm_min;
                    sec = timeinfo.tm_sec;
                    day = timeinfo.tm_mday;
                    month = timeinfo.tm_mon + 1;
                    year = timeinfo.tm_year + 1900;
                    weekday = timeinfo.tm_wday;
                }
            }
        }
    } else {
        if (wasConnected) {
            wasConnected = false;
            wifiConnected = false;
        }
    }
    if (wifiConnected && !ntpSynced) {
        struct tm timeinfo;
        if (getLocalTime(&timeinfo, 1)) {
            ntpSynced = true;
            hour = timeinfo.tm_hour;
            minute = timeinfo.tm_min;
            sec = timeinfo.tm_sec;
            day = timeinfo.tm_mday;
            month = timeinfo.tm_mon + 1;
            year = timeinfo.tm_year + 1900;
            weekday = timeinfo.tm_wday;
        }
    }
}

