bool isLightAvailable() { return digitalRead(LDR_PIN) == LOW; }

// ==================== CHECK AND HANDLE LIGHT CUT (FIXED - WITH RESET) ====================
void checkAndHandleLightCut() {
    static bool lastLightState = true;
    bool currentLight = isLightAvailable();
    
    // Light gayi (HIGH)
    if (!currentLight && lastLightState) {
        if (lightLostTime == 0) {
            lightLostTime = millis();
        }
        lightStopwatchRunning = true;
        lightNotAvailableStart = millis();
        lastLightAvailableTime = 0;
    }
    
    // ==================== LIGHT WAPAS AAYI (LOW) ====================
    if (currentLight && !lastLightState) {
        
        // ==================== RESET LIGHT OFFLINE TELEGRAM CYCLE ====================
        firstLightOffMsgSent = false;
        lastLightOffMsgTime = 0;
        
        if (lightStopwatchRunning) {
            unsigned long duration = millis() - lightLostTime;
            
            if (duration >= 12600000UL && !isTankFull()) {
                sys.stopFlag = false;
                sys.forceFlag = false;
                sys.timerType = AUTO_TANK_MODE;
                sys.motor = true;
                strcpy(notificationMsg, "RUNNING");
                if (wifiConnected) {
                    static unsigned long lastLightBackMsgTime = 0;
                    if (millis() - lastLightBackMsgTime > 4000) {
                        unsigned long totalSeconds = duration / 1000;
                        int hours = totalSeconds / 3600;
                        int mins = (totalSeconds % 3600) / 60;
                        
                        String timeText = "";
                        if (hours > 0) {
                            timeText += String(hours) + " hour";
                            if (hours > 1) timeText += "s";
                        }
                        if (mins > 0) {
                            if (timeText.length()) timeText += " ";
                            timeText += String(mins) + " min";
                        }
                        if (timeText == "") timeText = "few seconds";
                        
                        String msg = "🔆 Light " + timeText + " baad wapas aayi! Motor AUTO ON";
                        sendTelegramMessage(msg);
                        lastLightBackMsgTime = millis();
                    }
                }
                autoStartMessageSent = true;
                digitalWrite(RELAY_PIN, LOW);
            }
            
            lightStopwatchRunning = false;
            lightLostTime = 0;
        }
        lightNotAvailableStart = 0;
        lastLightAvailableTime = millis();
    }
    
    // Motor OFF on light cut
    if (sys.motor && !currentLight && lastLightState) {
        sys.motor = false;
        if (sys.timerType != 99 && sys.timerType != AUTO_TANK_MODE) {
            sys.forceFlag = false;
            sys.timerType = 0;
            sys.timerEndTime = 0;
            sys.customTimerSeconds = 0;
        }
        strcpy(notificationMsg, "LIGHT CUT");
        lightCutMessageShowing = true;
        lastLightCutTime = millis();
        noLightMessageShowing = false;
        waitingForLightReturn = false;
        if (wifiConnected) {
            static unsigned long lastLightCutMsgTime = 0;
            if (millis() - lastLightCutMsgTime > 4000) {
                sendTelegramMessage("⚡ LIGHT CUT! Motor Band Ho Gaya");
                lastLightCutMsgTime = millis();
            }
        }
    }
    
    // Light wapas aayi - display clear
    if (currentLight && !lastLightState) {
        if (sys.timerType == 99 && !lightCutMessageShowing && !waitingForLightReturn) {
            waitingForLightReturn = true;
            lightReturnTime = millis();
            strcpy(notificationMsg, "LIGHT BACK");
        }
    }
    
    if (waitingForLightReturn) {
        if (!isLightAvailable()) {
            waitingForLightReturn = false;
            if (!sys.motor && !sys.stopFlag && !tankFullMessageShowing && !lightCutMessageShowing)
                strcpy(notificationMsg, "READY");
        } else if ((millis() - lightReturnTime) > 2000) {
            waitingForLightReturn = false;
            if (sys.timerType == 99 && !isTankFull() && isLightAvailable()) {
                sys.motor = true;
                strcpy(notificationMsg, "RUNNING");
                if (wifiConnected) {
                    static unsigned long lastLightBackMsgTime = 0;
                    if (millis() - lastLightBackMsgTime > 4000) {
                        sendTelegramMessage("💡 Light 2 sec stable rahi → Motor ON (Auto)");
                        lastLightBackMsgTime = millis();
                    }
                }
                autoStartMessageSent = true;
                digitalWrite(RELAY_PIN, LOW);
            } else if (!lightCutMessageShowing && !tankFullMessageShowing && !noLightMessageShowing)
                strcpy(notificationMsg, "READY");
        }
    }
    
    if (lightCutMessageShowing && (millis() - lastLightCutTime) > 3000) {
        lightCutMessageShowing = false;
        if (!sys.motor && !sys.stopFlag && !tankFullMessageShowing && !waitingForLightReturn)
            strcpy(notificationMsg, "READY");
    }
    if (noLightMessageShowing && (millis() - noLightMsgStartTime) > 3000) {
        noLightMessageShowing = false;
        if (!sys.motor && !sys.stopFlag && !lightCutMessageShowing && !tankFullMessageShowing)
            strcpy(notificationMsg, "READY");
    }
    lastLightState = currentLight;
}

// ==================== AUTO MODE MANAGER (FIXED - 4 CONDITIONS) ====================
void autoModeManager() {
    bool bottomLow = digitalRead(TANK_LOW_PIN) == LOW;
    bool topLow    = digitalRead(TANK_HIGH_PIN) == LOW;

    // ==================== CONDITION 1: BOTH HIGH = LOW WATER ====================
    // Auto ON - Motor start karo
    if (!bottomLow && !topLow) {
        sys.motor = true;
        return;
    }

    // ==================== CONDITION 2: BOTTOM LOW + TOP HIGH ====================
    // Motor continue ONLY if it was already ON
    // Startup par No Action (auto start nahi karega)
    if (bottomLow && !topLow) {
        // Motor ko current state mein rehne do
        // Agar ON hai toh ON rahega, agar OFF hai toh OFF rahega
        // NAYI start nahi karega
        
        autoStartPending = false;
        telegramPending = false;
        displayLowWater = false;
        lowWaterWarningActive = false;

        if (!sys.stopFlag && !sys.motor) {
            strcpy(notificationMsg, "READY");
        }
        return;
    }

    // ==================== CONDITION 3: BOTH LOW = TANK FULL ====================
    if (bottomLow && topLow) {
        sys.motor = false;
        return;
    }

    // ==================== CONDITION 4: BOTTOM HIGH + TOP LOW ====================
    // Transition/Safety state - Motor OFF
    if (!bottomLow && topLow) {
        sys.motor = false;
        autoStartPending = false;
        telegramPending = false;
        displayLowWater = false;
        lowWaterWarningActive = false;

        if (!sys.stopFlag) {
            strcpy(notificationMsg, "READY");
        }
        return;
    }

    // Safety
    sys.motor = false;
}

