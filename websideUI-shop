// ==================== TELEGRAM ====================
void sendTelegramMessage(String msg) {
    if (!wifiConnected || telegramQueue == NULL) return;
    
    UBaseType_t queueItems = uxQueueMessagesWaiting(telegramQueue);
    
    if (queueItems > 10) {
        Serial.println("⚠️ Queue almost full! Clearing old messages...");
        char dummyMsg[160];
        while (uxQueueMessagesWaiting(telegramQueue) > 3) {
            xQueueReceive(telegramQueue, &dummyMsg, 0);
        }
    }
    
    char buf[160];
    msg.toCharArray(buf, 160);
    
    if (xQueueSend(telegramQueue, &buf, 0) != pdTRUE) {
        Serial.println("❌ Queue full! Message dropped: " + msg);
        char dummyMsg[160];
        while (uxQueueMessagesWaiting(telegramQueue) > 5) {
            xQueueReceive(telegramQueue, &dummyMsg, 0);
        }
        xQueueSend(telegramQueue, &buf, 0);
    }
}

