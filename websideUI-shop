    // Motor continue ONLY if already ON - NO new start
    if (lowSensor && !highSensor) {

        autoStartPending = false;
        telegramPending = false;

        displayLowWater = false;
        lowWaterWarningActive = false;
        lowWaterMsgSent = false;

        if (!sys.stopFlag && !sys.motor) {
            strcpy(notificationMsg, "READY");
        }

        return;
    }

    // ==================== CONDITION 4: BOTTOM HIGH + TOP LOW ====================
    // Transition/Safety state - Motor OFF
    if (!lowSensor && highSensor) {

        autoStartPending = false;
        telegramPending = false;

        displayLowWater = false;
        lowWaterWarningActive = false;
        lowWaterMsgSent = false;

        if (!sys.stopFlag) {
            strcpy(notificationMsg, "READY");
        }

        sys.motor = false;
        return;
    }

    // ==================== CONDITION 1: BOTH HIGH = LOW WATER ====================
    if (!lowSensor && !highSensor) {

        // ==================== LIGHT NOT AVAILABLE ====================
        if (!isLightAvailable()) {
            sys.motor = false;

            autoStartPending = false;
            telegramPending = false;

            displayLowWater = true;
            lowWaterWarningActive = true;

            strcpy(notificationMsg, "LOW WATER");
            
            // ==================== TELEGRAM LIGHT OFFLINE MESSAGES ====================
            // firstLightOffMsgSent and lastLightOffMsgTime are now GLOBAL variables
            
            if (wifiConnected && !firstLightOffMsgSent) {
                firstLightOffMsgSent = true;
                alertStartTime = millis();
                lastLightOffMsgTime = millis();
                
                String msg = "💡 Light: Offline since 0 min";
                msg += "\n     Light: Out of Coverage Area 📵";
                msg += "\n     Tank Low Water Detect 💧";
                sendTelegramMessage(msg);
            }
            
            if (wifiConnected && firstLightOffMsgSent && (millis() - lastLightOffMsgTime) >= TELEGRAM_REPEAT_INTERVAL) {
                lastLightOffMsgTime = millis();
                unsigned long elapsedMs = millis() - lightLostTime;
                unsigned long elapsedMinutes = elapsedMs / 60000;
                
                int hours = elapsedMinutes / 60;
                int mins = elapsedMinutes % 60;
                
                String timeText = "";
                
                if (hours > 0) {
                    timeText += String(hours) + " hour";
                    if (hours > 1) timeText += "s";
                }
                
                if (mins > 0) {
                    if (timeText.length()) timeText += " ";
                    timeText += String(mins) + " min";
                }
                
                String msg = "💡 Light: Offline since " + timeText;
                msg += "\n     Light: Out of Coverage Area 📵";
                msg += "\n     Tank Low Water Detect 💧";
                sendTelegramMessage(msg);
                buzzerBeep(200, 1, 0);
            }
            
            return;
        }

        // ==================== BOOT DELAY ====================
        if (bootDelayActive) {
            if (millis() - bootTime < 30000) {
                displayLowWater = true;
                lowWaterWarningActive = true;
                return;
            }
            bootDelayActive = false;
        }

        // ==================== START 30-SECOND PENDING TIMER ====================
        if (!sys.motor &&
            !autoTankStartBlocked &&
            !autoStartPending) {

            autoStartPending = true;
            autoStartTime = millis();

            displayLowWater = true;
            lowWaterWarningActive = true;

            strcpy(notificationMsg, "LOW WATER");
            
            if (wifiConnected && !lowWaterMsgSent) {
                String lowWaterMsgs[] = {
                    "😰 Alert! Paani khatam!",
                    "🚨 Tank Empty! Motor ready to start...",
                    "💧 Low Water! Wait 30 sec...",
                    "😱 Emergency! Paani nahi hai!",
                    "🆘 Tank needs water! ⏳ 30 sec..."
                };
                static int msgIndex = 0;
                sendTelegramMessage(lowWaterMsgs[msgIndex]);
                msgIndex++;
                if (msgIndex > 4) msgIndex = 0;
                lowWaterMsgSent = true;
            }
        }

        // ==================== 30 SECONDS COMPLETED - AUTO ON ====================
        if (autoStartPending &&
            (millis() - autoStartTime >= 30000UL)) {

            autoStartPending = false;

            sys.stopFlag = false;
            sys.forceFlag = false;
            sys.timerType = AUTO_TANK_MODE;
            sys.motor = true;

            strcpy(notificationMsg, "RUNNING");

            digitalWrite(RELAY_PIN, LOW);

            telegramPending = true;
            telegramTime = millis();
            
            lowWaterMsgSent = false;
        }

        return;
    }

    // Safety fallback
    sys.motor = false;
}

// ==================== SMART TIME PARSER ====================
int parseTimeSmart(String input) {
    input.trim();
    input.toLowerCase();
    input.replace(" ", "");
    input.replace("minutes", "m");
    input.replace("minute", "m");
    input.replace("minite", "m");
    input.replace("mint", "m");
    input.replace("min", "m");
    input.replace("seconds", "s");
    input.replace("second", "s");
    input.replace("seco", "s");
    input.replace("sec", "s");

    if (input.indexOf('.') != -1 && (input.endsWith("m") || input.endsWith("s"))) {
        int dot = input.indexOf('.');
        String mStr = input.substring(0, dot);
        String sStr = input.substring(dot + 1, input.length() - 1);
        if (mStr.length() == 0 || sStr.length() == 0) return -1;
        int m = mStr.toInt();
        int s = sStr.toInt();
        if (s >= 60) return -1;
        return m * 60 + s;
    }
    if (input.indexOf(':') != -1) {
        int colon = input.indexOf(':');
        int m = input.substring(0, colon).toInt();
        int s = input.substring(colon + 1).toInt();
        if (s >= 60) return -1;
        return m * 60 + s;
    }
    int total = 0, num = 0;
    bool hasAny = false;
    for (int i = 0; i < input.length(); i++) {
        char c = input[i];
        if (isDigit(c)) { num = num * 10 + (c - '0'); hasAny = true; }
        else if (c == 'm') { total += num * 60; num = 0; }
        else if (c == 's') { total += num; num = 0; }
        else return -1;
    }
    if (num > 0) total += num;
    if (!hasAny || total <= 0) return -1;
    return total;
}

