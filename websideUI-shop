                msgIndex++;
                if (msgIndex > 9) msgIndex = 0;
            }
        } else {
            sys.motor = true;
        }
    }
    else {
        sys.motor = false;
    }
    
    // Priority Order
    if (lightCutMessageShowing) {
        // keep
    }
    else if (tankFullMessageShowing) {
        // keep
    }
    else if (noLightMessageShowing) {
        strcpy(notificationMsg, "NO LIGHT");
        if (millis() - noLightMsgStartTime >= 2000) {
            noLightMessageShowing = false;
            if (!sys.motor && !sys.stopFlag && !lightCutMessageShowing && !tankFullMessageShowing && !displayLowWater)
                strcpy(notificationMsg, "READY");
        }
    }
    else if (displayLowWater && !sys.motor) {
        strcpy(notificationMsg, "LOW WATER");
    }
    else if (showingStopMessage) {
        strcpy(notificationMsg, "STOP");
        specialEventActive = false;
    }
    else if (sys.forceFlag) {
        strcpy(notificationMsg, "OVERRIDE");
        specialEventActive = false;
    }
    else if (sys.motor) {
        strcpy(notificationMsg, "RUNNING");
        specialEventActive = false;
    }
    else {
        if (!lightCutMessageShowing && !tankFullMessageShowing && 
            !noLightMessageShowing && !displayLowWater && 
            !showingStopMessage) {
            EventSteps ev = getEventSteps(month, day);
            if (ev.stepCount > 0) {
                if (!specialEventActive) {
                    specialEventActive = true;
                    specialEventStep = 0;
                    specialEventLastSwitch = now;
                }
                if (now - specialEventLastSwitch >= SPECIAL_STEP_DURATION) {
                    specialEventStep++;
                    if (specialEventStep >= ev.stepCount) specialEventStep = 0;
                    specialEventLastSwitch = now;
                }
                strcpy(notificationMsg, ev.steps[specialEventStep]);
            } else {
                specialEventActive = false;
                strcpy(notificationMsg, "READY");
            }
        }
    }
    
    // ==================== NIGHT CLOCK MODE ====================
    if (isNightMode()) {
        if (sys.motor) {
            nightClockMode = false;
            nightClockDelay = 0;
        } else {
            if (nightClockDelay == 0)
                nightClockDelay = millis();

            if (millis() - nightClockDelay >= 2000)
                nightClockMode = true;
        }
    } else {
        nightClockMode = false;
        nightClockDelay = 0;
    }

    if (sys.motor)
        nightClockDelay = 0;
}

