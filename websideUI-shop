// ==================== BUZZER ====================
void buzzerBeep(int duration, int repeat, int delayMs) {
    for (int i = 0; i < repeat; i++) {
        digitalWrite(BUZZER_PIN, HIGH);
        delay(duration);
        digitalWrite(BUZZER_PIN, LOW);
        if (i < repeat - 1) delay(delayMs);
    }
}

// ==================== EEPROM ====================
unsigned long getBootCount() {
  unsigned long count;
  EEPROM.get(EE_BOOT_COUNT, count);
  if (count == 0xFFFFFFFF || count == 0) return 1;
  return count;
}

void incrementBootCount() {
  unsigned long count = getBootCount();
  count++;
  EEPROM.put(EE_BOOT_COUNT, count);
  EEPROM.commit();
}

